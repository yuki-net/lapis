---
// セクション切り替えをサイドバー先頭に置く。
// セクションが増えても横スクロールで追従できる構造にする。
// サイドバーの構成自体は astro.config.mjs が正本で、ここではグループ単位で絞り込む。
import MobileMenuFooter from '@astrojs/starlight/components/MobileMenuFooter.astro';
import SidebarPersister from '@astrojs/starlight/components/SidebarPersister.astro';
import SidebarSublist from '@astrojs/starlight/components/SidebarSublist.astro';
import { currentSection, sections } from '../data/nav';

const { sidebar } = Astro.locals.starlightRoute;
const section = currentSection(Astro.url.pathname);
const group = section
  ? sidebar.find((entry) => entry.type === 'group' && entry.label === section.group)
  : undefined;
const entries = group?.type === 'group' ? group.entries : sidebar;
---

<nav class="lapis-section-tabs" aria-label="セクション">
  <ul>
    {
      sections.map((item) => {
        const active = section?.label === item.label;
        return (
          <li>
            <a
              href={item.href}
              class:list={['lapis-section-tab', { active }]}
              aria-current={active ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>

<SidebarPersister>
  <SidebarSublist sublist={entries} />
</SidebarPersister>

<div class="md:sl-hidden">
  <MobileMenuFooter />
</div>
