---
// 前へ / 次へをタブ内（同じセクション）に限定する。
// 既定の Pagination はサイト全体のサイドバー順を使うため、セクションを跨いでしまう。
import { currentSection } from '../data/nav';

const { sidebar, dir } = Astro.locals.starlightRoute;
const section = currentSection(Astro.url.pathname);
const group = section
  ? sidebar.find((entry) => entry.type === 'group' && entry.label === section.group)
  : undefined;
const entries = group?.type === 'group' ? group.entries : sidebar;

const links: { href: string; label: string; isCurrent: boolean }[] = [];
const walk = (items: typeof entries) => {
  for (const entry of items) {
    if (entry.type === 'link') links.push(entry);
    else walk(entry.entries);
  }
};
walk(entries);

const index = links.findIndex((link) => link.isCurrent);
const prev = index > 0 ? links[index - 1] : undefined;
const next = index >= 0 && index < links.length - 1 ? links[index + 1] : undefined;
const isRtl = dir === 'rtl';
---

<div class="pagination-links print:hidden" dir={dir}>
  {
    prev && (
      <a href={prev.href} rel="prev">
        <span class="arrow" aria-hidden="true">
          {isRtl ? '→' : '←'}
        </span>
        <span>
          {Astro.locals.t('page.previousLink')}
          <br />
          <span class="link-title">{prev.label}</span>
        </span>
      </a>
    )
  }
  {
    next && (
      <a href={next.href} rel="next">
        <span class="arrow" aria-hidden="true">
          {isRtl ? '←' : '→'}
        </span>
        <span>
          {Astro.locals.t('page.nextLink')}
          <br />
          <span class="link-title">{next.label}</span>
        </span>
      </a>
    )
  }
</div>

<style>
  @layer starlight.core {
    .pagination-links {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(18rem, 100%), 1fr));
      gap: 1rem;
    }

    a {
      display: flex;
      align-items: center;
      justify-content: flex-start;
      gap: 0.5rem;
      width: 100%;
      flex-basis: calc(50% - 0.5rem);
      flex-grow: 1;
      border: 1px solid var(--sl-color-gray-5);
      border-radius: 0.5rem;
      padding: 1rem;
      text-decoration: none;
      color: var(--sl-color-gray-2);
      box-shadow: var(--sl-shadow-md);
      overflow-wrap: anywhere;
    }
    [rel='next'] {
      justify-content: end;
      text-align: end;
      flex-direction: row-reverse;
    }
    a:hover {
      border-color: var(--sl-color-gray-2);
    }

    .arrow {
      flex-shrink: 0;
      font-size: 1.25rem;
      line-height: 1;
    }

    .link-title {
      color: var(--sl-color-white);
      font-size: var(--sl-text-2xl);
      line-height: var(--sl-line-height-headings);
    }
  }
</style>
