diff --git a/apps/desktop/ui/src/hot_reload.rs b/apps/desktop/ui/src/hot_reload.rs
new file mode 100644
index 0000000..b53d338
--- /dev/null
+++ b/apps/desktop/ui/src/hot_reload.rs
@@ -0,0 +1,24 @@
+use std::sync::{Arc, OnceLock};
+
+use gpui::App;
+
+// PoC: プロセス全体で通知を一度だけ登録し、UIスレッドへ最大1件を転送する。
+pub(crate) fn init(cx: &mut App) {
+    static STARTED: OnceLock<()> = OnceLock::new();
+    if STARTED.set(()).is_err() {
+        return;
+    }
+    let (sender, receiver) = async_channel::bounded(1);
+    subsecond::register_handler(Arc::new(move || {
+        let _ = sender.try_send(());
+    }));
+    cx.spawn(async move |cx| {
+        while receiver.recv().await.is_ok() {
+            if cx.update(|cx| cx.refresh_windows()).is_err() {
+                break;
+            }
+        }
+    })
+    .detach();
+    dioxus_devtools::connect_subsecond();
+}
