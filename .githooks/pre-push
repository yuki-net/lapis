#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# テスト内の一時リポジトリへ、親フックのGit contextを漏らさない。
git_local_env=$(git rev-parse --local-env-vars)
unset $git_local_env

# 全検証はGitHub CIで実行します。
echo "[pre-push] Checking the workspace..."
cargo check --workspace --all-targets

echo "[pre-push] Running workspace tests..."
cargo test --workspace --all-targets

echo "[pre-push] Running clippy..."
cargo clippy --workspace --all-targets -- -D warnings
