#!/bin/sh
set -eu

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# テスト内の一時リポジトリへ、親フックのGit contextを漏らさない。
git_local_env=$(git rev-parse --local-env-vars)
unset $git_local_env

# コミット時は整形のみ。変更関連のテストは手元で、全検証はCIで実行する。
echo "[pre-commit] Checking Rust formatting..."
cargo fmt --all -- --check
